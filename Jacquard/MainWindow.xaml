<Window x:Class="Jacquard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Jacquard"
        mc:Ignorable="d"
        Title="Jacquard" Height="600" Width="525">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Button Margin="10,10,10,5" Click="OpenImage_Click" ToolTip="Select Image">
            <TextBlock TextTrimming="CharacterEllipsis">
                Select Image
            </TextBlock>
        </Button>
        <TextBox x:Name="Output" Margin="10,5,10,5" Text="" FontFamily="Lucida Console"  Foreground="Magenta" FontSize="20" Padding="5" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.ColumnSpan="5" IsReadOnly="True"/>
        <Border BorderBrush="#FFABADB3" BorderThickness="1" Margin="10,5,10,10" Grid.Row="2" Padding="5" Grid.ColumnSpan="5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ImageCanvas" Orientation="Vertical"/>
            </ScrollViewer>
        </Border>
        <Button ToolTip="Copy Text" Margin="5,10,10,5" Click="CopyText_Click" Grid.Column="1">
            <TextBlock TextTrimming="CharacterEllipsis">
                Copy Text
            </TextBlock>
        </Button>
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="9.8,10,0,0" Text="Max image width" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"/>
        <TextBox x:Name="scall" Grid.Column="2" Margin="10,31,35.2,0" TextWrapping="Wrap" Text="auto" Height="19" VerticalAlignment="Top" Foreground="Gray" LostFocus="IamgeWidth_LostFocus" TextChanged="IamgeWidth_TextChanged" FontStyle="Italic"/>
        <Button ToolTip="Reset" Margin="5,10,10,5" Click="Reset_Click" Grid.Column="3">
            <TextBlock TextTrimming="CharacterEllipsis">
                Reset
            </TextBlock>
        </Button>
        <Button Content="&#xE117;" Grid.Column="2" FontFamily="Segoe UI Symbol" HorizontalAlignment="Right" Margin="0,31,5.2,0" ToolTip="Refresh" VerticalAlignment="Top" Width="25" Height="19"/>


    </Grid>
</Window>
