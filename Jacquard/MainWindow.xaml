<Window x:Class="Jacquard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jacquard" Width="1000" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#FAFAFA" FontSize="13"
        AllowDrop="True" PreviewDrop="Window_PreviewDrop" PreviewDragOver="Window_PreviewDragOver" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>
        <Style x:Key="Separator" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Fill" Value="#DDD"/>
            <Setter Property="Margin" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*" MinHeight="60"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel>
                <Button x:Name="OpenButton" Click="Open_Click" ToolTip="Open an image (Ctrl+O). You can also drop one on the window.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8E5;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Open image…"/>
                    </StackPanel>
                </Button>

                <Rectangle Style="{StaticResource Separator}"/>

                <TextBlock Style="{StaticResource Label}" Text="Width"/>
                <Grid VerticalAlignment="Center">
                    <TextBox x:Name="WidthBox" Width="64" Padding="4,3" TextChanged="WidthBox_TextChanged"
                             ToolTip="Squares across the pattern, from 1 to 640. Leave it empty for the suggested width."/>
                    <TextBlock x:Name="WidthPlaceholder" Text="auto" Foreground="#999" FontStyle="Italic" Margin="7,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <TextBlock x:Name="HeightText" Style="{StaticResource Label}" Margin="6,0,10,0" Text="squares"/>
                <TextBlock x:Name="SuggestionText" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666" Visibility="Collapsed">
                    <Run x:Name="SuggestionRun"/>
                    <Hyperlink Click="UseSuggested_Click">Use</Hyperlink>
                </TextBlock>

                <Rectangle Style="{StaticResource Separator}"/>

                <TextBlock Style="{StaticResource Label}" Text="Threshold"/>
                <Slider x:Name="ThresholdSlider" Width="140" Minimum="1" Maximum="255" Value="130" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="ThresholdSlider_ValueChanged"
                        ToolTip="Pixels darker than this become filled squares. Move it right to fill more."/>
                <TextBlock x:Name="ThresholdText" Style="{StaticResource Label}" Margin="6,0,0,0" Width="28" Text="130"/>
                <CheckBox x:Name="InvertCheck" Content="Invert" VerticalAlignment="Center" Margin="4,0,0,0"
                          Checked="InvertCheck_Changed" Unchecked="InvertCheck_Changed"
                          ToolTip="Swap filled and empty: the light parts become filled squares (1) and the dark parts empty."/>

                <Rectangle Style="{StaticResource Separator}"/>

                <Button x:Name="CopyButton" Click="Copy_Click" IsEnabled="False"
                        ToolTip="Copy the pattern as text, a tab between squares, ready to paste into Excel.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8C8;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Copy text"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Validation and hints -->
        <Border x:Name="MessageBar" Grid.Row="1" Padding="12,6" Visibility="Collapsed" BorderThickness="0,0,0,1">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        </Border>

        <!-- Pattern preview -->
        <Grid Grid.Row="2">
            <!-- A free canvas: the pattern can always be moved in any direction, zoomed around the pointer or fingers. -->
            <Border x:Name="PreviewArea" Background="#EDEDED" ClipToBounds="True" IsManipulationEnabled="True"
                    ManipulationStarting="Preview_ManipulationStarting" ManipulationDelta="Preview_ManipulationDelta"
                    ManipulationInertiaStarting="Preview_ManipulationInertiaStarting"
                    PreviewTouchDown="Preview_TouchDown" PreviewTouchUp="Preview_TouchUp"
                    PreviewMouseWheel="Preview_MouseWheel" PreviewMouseLeftButtonDown="Preview_MouseLeftButtonDown"
                    PreviewMouseMove="Preview_MouseMove" PreviewMouseLeftButtonUp="Preview_MouseLeftButtonUp"
                    SizeChanged="PreviewArea_SizeChanged">
                <Canvas>
                    <Grid x:Name="PreviewHost" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="PreviewMove"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Image x:Name="PatternImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Rectangle x:Name="GridOverlay" IsHitTestVisible="False"/>
                    </Grid>
                </Canvas>
            </Border>

            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="#888" FontSize="15"
                       IsHitTestVisible="False" Text="Open an image, or drop one here.&#x0a;It becomes a grid of filled and empty squares for knitting or weaving."/>

            <!-- Zoom controls -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Padding="4" CornerRadius="4"
                    Background="#F2FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)"/>
                    <TextBlock x:Name="ZoomText" Width="52" TextAlignment="Center" VerticalAlignment="Center" Text="100%"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE9A6;" Click="Fit_Click" ToolTip="Fit to window (Ctrl+0, or double-click the pattern)"/>
                    <CheckBox x:Name="GridCheck" Content="Grid" IsChecked="True" VerticalAlignment="Center" Margin="8,0,4,0"
                              Checked="GridCheck_Changed" Unchecked="GridCheck_Changed" ToolTip="Lines between squares when zoomed in"/>
                </StackPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#E0E0E0" ResizeDirection="Rows"/>

        <!-- Text output -->
        <TextBox x:Name="OutputText" Grid.Row="4" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Foreground="#C2185B"
                 BorderThickness="0" Padding="8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

        <!-- Status bar -->
        <Border Grid.Row="5" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="InfoText" DockPanel.Dock="Right" Foreground="#666" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Progress" DockPanel.Dock="Left" Width="160" Height="10" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Foreground="#444" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
